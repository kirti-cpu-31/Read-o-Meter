{
  "manifest_version": 3,
  "name": "Read-o-Meter",
  "version": "1.1.0",
  "description": "Track reading progress, pace and time left, with themes, text size and bionic reading.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Read-o-Meter"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}